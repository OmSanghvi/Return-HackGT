# Development only. Do not put cloud credentials or HF tokens here.
PIPELINE_MODE=mock
SKETCHSCAPE_DATA_DIR=./data
SKETCHSCAPE_ALLOWED_ORIGINS=*

# Set only on the GPU host, and use the same random value in its worker.
# SKETCHSCAPE_WORKER_TOKEN=

# Identity (backend/auth.py, Build Plan step 16): mock (default, local only) |
# demo (the real identity model for the Collaborative VR track -- two
# hardcoded accounts) | clerk (retired, kept for a possible future upgrade).
SKETCHSCAPE_AUTH_MODE=mock
# demo mode only -- exactly two accounts; the account switcher (website and
# Quest) reads this list, so a demo can rename them without a code change.
# SKETCHSCAPE_DEMO_USERS=demo-alice,demo-bob
# demo/clerk mode only -- explicit web origins, never "*". Comma-separated;
# include every origin that calls this API. Local dev uses the Vite dev
# server; the live web app's production origin is the Vercel deployment.
# SKETCHSCAPE_WEB_ORIGINS=http://localhost:5173,https://returnweb-hazel.vercel.app

# NemoClaw's service identity (Build Plan step 21/R14): a shared bearer token
# NemoClaw sends as `Authorization: Bearer <token>`, giving kind="service"
# regardless of SKETCHSCAPE_AUTH_MODE. Must be at least 32 characters when
# set (e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`);
# the backend refuses to start with a shorter one. Leave unset locally --
# NemoClaw's service identity isn't needed until step 24's room tools.
# SKETCHSCAPE_NEMOCLAW_TOKEN=

# Upload labeling (identify_subject, Build Plan step 4a). `mock` (default)
# reads descriptive filenames. `nemoclaw` asks NemoClaw's model (Muse Spark)
# inside the sandbox via the sketchscape-subject-labeler skill; it needs the
# `nemoclaw` CLI on this machine (in WSL on Windows) and takes ~15-25 s a call.
# SKETCHSCAPE_SUBJECT_LABELER=mock
# NEMOCLAW_SANDBOX=sketchscape
# NEMOCLAW_WSL_DISTRO=Ubuntu      # only when the backend runs on Windows

# Fast-SAM3D speed tuning (defaults tuned for T4 — change only if quality is unacceptable)
# FASTSAM3D_MAX_INPUT_SIDE=512   # 512 cuts MoGe compute ~55% vs 768; raise to 768 for higher quality
# FASTSAM3D_STAGE1_STEPS=8       # diffusion steps for sparse structure (min 6, max 20)
# FASTSAM3D_STAGE2_STEPS=8       # diffusion steps for SLaT (min 6, max 20)
# FASTSAM3D_FP16=1               # 0 to disable FP16 (slower but more numerically stable)

# Authoring-state persistence backend: local (default JSON file) or dynamodb.
SKETCHSCAPE_STORAGE_BACKEND=local
# Required only when SKETCHSCAPE_STORAGE_BACKEND=dynamodb.
# Obtain the table name from: terraform output -raw dynamodb_table_name
# AWS credentials come from the standard credential chain (instance role, env,
# or profile) — never from this file.
# SKETCHSCAPE_DYNAMODB_TABLE=sketchscape-authoring
# AWS_REGION=us-east-2

# Artifact storage backend: local (default, files under SKETCHSCAPE_DATA_DIR)
# or s3 (stream PLY/mask/preview to the provisioned S3 bucket).
SKETCHSCAPE_ARTIFACTS_BACKEND=local
# Required only when SKETCHSCAPE_ARTIFACTS_BACKEND=s3.
# Obtain the bucket name from: terraform output -raw artifacts_bucket
# The EC2 instance role has PutObject/GetObject/DeleteObject on artifacts/*
# automatically when enable_artifacts_bucket=true in terraform.tfvars.
# SKETCHSCAPE_ARTIFACTS_BUCKET=sketchscape-artifacts-xxxxxxxx
# AWS_REGION=us-east-2  (shared with DynamoDB when both are enabled)

# Image generation backend for Notability sketch → photorealistic image conversion.
# mock (default, no network) | azure | hf
SKETCHSCAPE_IMAGE_GEN_BACKEND=mock
# Required only when SKETCHSCAPE_IMAGE_GEN_BACKEND=azure:
# SKETCHSCAPE_AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com
# SKETCHSCAPE_AZURE_OPENAI_KEY=<key>
# SKETCHSCAPE_AZURE_OPENAI_DEPLOYMENT=dall-e-3
# Required only when SKETCHSCAPE_IMAGE_GEN_BACKEND=hf:
# SKETCHSCAPE_HF_TOKEN=hf_...
# SKETCHSCAPE_HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Guide runtime (Build Plan step 32): the in-VR guide bot's backend.
# mock (default, no network) | meta | xai | nebius
SKETCHSCAPE_GUIDE_MODEL_PROVIDER=mock
# Overrides the provider's default model (muse-spark-1.3 for meta).
# SKETCHSCAPE_GUIDE_MODEL=
# scripted next/repeat/start/end always skip the model; hybrid (default)
# sends more/ask_about/linger/question to it; model_all is eval-only.
SKETCHSCAPE_GUIDE_ROUTING=hybrid
SKETCHSCAPE_GUIDE_MAX_TURNS_PER_SESSION=60
SKETCHSCAPE_GUIDE_DAILY_MODEL_TURNS=500
SKETCHSCAPE_GUIDE_MODEL_TIMEOUT_S=15
# none (default, always in tests) | mms (Meta MMS-TTS, CC-BY-NC 4.0 --
# already accepted for the demo in step 6; flag before any commercial use).
SKETCHSCAPE_GUIDE_TTS=none
# Required only when SKETCHSCAPE_GUIDE_MODEL_PROVIDER is meta/xai/nebius --
# never committed, backend process env only (never a file, config/, the web
# app, or Unity):
# META_MODEL_API_KEY=
# XAI_API_KEY=
# NEBIUS_API_KEY=
