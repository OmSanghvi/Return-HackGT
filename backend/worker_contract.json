{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SketchScape GPU worker result",
  "description": "The cloud GPU worker writes this after automatic segmentation and SAM 3D inference.",
  "type": "object",
  "required": ["status", "input_job_id"],
  "properties": {
    "status": { "enum": ["complete", "mask_review", "failed"] },
    "input_job_id": { "type": "string" },
    "mask_path": { "type": "string", "description": "Aligned binary PNG; white is the object." },
    "mask_preview_path": { "type": "string" },
    "ply_path": { "type": "string", "description": "Gaussian-splat PLY output." },
    "object_label": { "type": "string" },
    "error": { "type": "string" }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "complete" } } },
    "then": { "required": ["ply_path", "mask_path"] }
  }]
}
