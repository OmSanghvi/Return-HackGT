{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sketchscape.dev/schemas/experience-blueprint.schema.json",
  "title": "SketchScape Experience Blueprint",
  "description": "Authoring contract for a versioned experience. A published blueprint is the source of truth consumed by scene compilers and platform adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "revision",
    "experience",
    "environment",
    "objects",
    "portals",
    "navigation",
    "created_at"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "theme", "units"],
      "properties": {
        "mode": {
          "enum": ["desktop", "ar", "vr", "ar_vr"]
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "const": "meters"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lighting_preset", "skybox", "floor", "ambient_audio"],
      "properties": {
        "lighting_preset": {
          "type": "string",
          "minLength": 1
        },
        "skybox": {
          "type": ["string", "null"]
        },
        "floor": {
          "type": "boolean"
        },
        "ambient_audio": {
          "type": ["string", "null"]
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sceneObject"
      }
    },
    "portals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/portal"
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vr", "ar"],
      "properties": {
        "vr": {
          "enum": ["teleport", "smooth", "none"]
        },
        "ar": {
          "enum": ["surface-placement", "world-anchor", "none"]
        }
      }
    },
    "staging": {
      "description": "Optional immersive staging from NemoClaw's stage_immersive_reveal (Build Plan step 6). Compiled into meta.staging for Unity's ImmersiveStagingDirector.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "reveal_order": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string" }
        },
        "lighting_preset": { "type": "string", "maxLength": 80 },
        "connecting_motif": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["color"],
          "properties": {
            "type": { "type": "string", "maxLength": 40 },
            "curve": { "type": "string", "maxLength": 40 },
            "color": { "$ref": "#/$defs/vector3" },
            "control_points": {
              "type": "array",
              "maxItems": 210,
              "items": { "$ref": "#/$defs/vector3" }
            }
          }
        },
        "narration": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "maxLength": 1000 },
            "voice": { "type": "string", "maxLength": 80 },
            "tts_engine": { "type": ["string", "null"], "maxLength": 80 }
          }
        },
        "haptic_signatures": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "summary": { "type": ["string", "null"], "maxLength": 1000 }
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotation", "scale"],
      "properties": {
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "rotation": {
          "$ref": "#/$defs/vector3"
        },
        "scale": {
          "$ref": "#/$defs/vector3"
        }
      }
    },
    "sceneObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset_id",
        "position",
        "rotation",
        "scale",
        "interactions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "rotation": {
          "$ref": "#/$defs/vector3"
        },
        "scale": {
          "$ref": "#/$defs/vector3"
        },
        "interactions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "highlight",
              "inspect",
              "scale",
              "translate",
              "rotate",
              "activate",
              "grab"
            ]
          }
        },
        "contribution_id": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "placement": {
          "description": "upright: Unity stands the Z-up scan on the floor at the origin. pose: the transform already carries the scan's pose from its photo (scene_layout.py); apply it exactly.",
          "enum": ["upright", "pose"]
        }
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_project_id", "position", "rotation", "scale"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target_project_id": {
          "type": "string",
          "minLength": 1
        },
        "target_revision": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Pinned published revision, or null to resolve the target project's current published revision."
        },
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "rotation": {
          "$ref": "#/$defs/vector3"
        },
        "scale": {
          "$ref": "#/$defs/vector3"
        }
      }
    }
  }
}
