{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SketchScape Unity scene configuration profile",
  "type": "object",
  "required": ["profile_version", "scene", "required_components", "required_references", "acceptance_checks"],
  "properties": {
    "profile_version": { "const": 1 },
    "scene": {
      "type": "object",
      "required": ["selection", "save_before_changes", "checkpoint_label"],
      "properties": {
        "selection": { "enum": ["active"] },
        "save_before_changes": { "const": true },
        "checkpoint_label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "required_components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "singleton"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "singleton": { "type": "boolean" },
          "optional": { "type": "boolean" },
          "properties": { "type": "object" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "required_references": { "type": "array", "items": { "type": "string" } },
    "acceptance_checks": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
