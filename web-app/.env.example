# Copy to .env.development / .env.production (both git-ignored) as needed.
# Unset (or empty) VITE_SKETCHSCAPE_API_URL: the site is fully client-side --
# mock sign-in, photos as data URLs, timed animations. Nothing below is used.
# Set it: real mode -- an account picker, and real calls to the FastAPI
# backend. See web-app/hardcode.MD and vercel.json.

# Local dev, talking straight to `uvicorn main:app` on your machine:
# VITE_SKETCHSCAPE_API_URL=http://localhost:8000

# Production, once vercel.json's /api/:path* rewrite has a real backend host:
# VITE_SKETCHSCAPE_API_URL=/api

# Only ever the public account ids (never a secret -- Vite bakes every VITE_*
# value into the public bundle). Optional; defaults to demo-alice,demo-bob to
# match the backend's SKETCHSCAPE_DEMO_USERS default.
# VITE_SKETCHSCAPE_ACCOUNTS=demo-alice,demo-bob
